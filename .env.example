# ==============================================================================
# ENVIRONMENT VARIABLES - EduInformatika Mobile App
# Salin file ini menjadi `.env` lalu isi dengan kredensial database Anda
# ==============================================================================

# ==============================================================================
# SUPABASE (Legacy - masih didukung untuk backward compatibility)
# ==============================================================================
# URL Project Supabase Anda (Settings -> API -> Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Settings -> API -> Project API Keys -> anon/public)
# JANGAN PERNAH menaruh service_role key di aplikasi mobile!
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...VCJ9...

# Master Kode Undangan Registrasi Guru (Harus cocok saat guru mendaftar)
EXPO_PUBLIC_TEACHER_INVITE_CODE=GURU-INFORMATIKA-2026

# ==============================================================================
# NEON POSTGRESQL (Primary Database - Recommended)
# ==============================================================================
# Neon Database Connection String (Project Settings -> Connection String)
# Format: postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
EXPO_PUBLIC_NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/eduinformatika?sslmode=require

# Neon Project ID (untuk referensi)
EXPO_PUBLIC_NEON_PROJECT_ID=your-neon-project-id